<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7F6">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvRecTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recommendations for You"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#005662"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvRecSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Based on your current state"
            android:textSize="16sp"
            android:textColor="#555555"
            android:layout_marginBottom="24dp"/>

        <!-- Activity Card 1: Breathing -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="#E0F2F1">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🧘 4-7-8 Breathing Exercise"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#000000"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Inhale 4s, Hold 7s, Exhale 8s. Calms the nervous system."
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <Button
                        android:id="@+id/btnStartBreathing"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Start 15s Timer"
                        android:textAllCaps="false"
                        android:backgroundTint="#00838f"/>

                    <TextView
                        android:id="@+id/tvBreathingStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textStyle="bold"
                        android:textColor="#00838f"
                        android:layout_marginStart="16dp"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Activity Card 2: Quick Game / Distraction -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="#FFF3E0">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🧩 Mental Reset"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#000000"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="A quick distraction resets your cognitive loop."
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp"/>

                <Button
                    android:id="@+id/btnPlayGame"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mark as Done"
                    android:textAllCaps="false"
                    android:backgroundTint="#E65100"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Activity Card 3: Physical -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="#E8F5E9">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚶 Power Stretch"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#000000"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Stand up and stretch for 2 minutes to boost circulation."
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp"/>

                <Button
                    android:id="@+id/btnStretch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mark as Done"
                    android:textAllCaps="false"
                    android:backgroundTint="#2E7D32"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btnFinishActivities"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Finish and Save Session"
            android:textAllCaps="false"
            android:backgroundTint="#005662"
            android:layout_marginTop="8dp"/>

    </LinearLayout>
</ScrollView>