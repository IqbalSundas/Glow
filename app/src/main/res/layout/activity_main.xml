<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Camera Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Pulsing Face Guide Overlay -->
    <View
        android:id="@+id/faceGuideOverlay"
        android:layout_width="250dp"
        android:layout_height="320dp"
        android:background="@drawable/oval_guide"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Premium Circular Loader (Hidden by default) -->
    <ProgressBar
        android:id="@+id/progressLoader"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:indeterminate="true"
        android:visibility="gone"
        android:indeterminateTint="#00e5ff"
        app:layout_constraintTop_toTopOf="@id/faceGuideOverlay"
        app:layout_constraintBottom_toBottomOf="@id/faceGuideOverlay"
        app:layout_constraintStart_toStartOf="@id/faceGuideOverlay"
        app:layout_constraintEnd_toEndOf="@id/faceGuideOverlay"/>

    <!-- Status Text -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Align your face in the oval"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:background="#99000000"
        android:padding="10dp"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Start Check-in Button -->
    <Button
        android:id="@+id/btnStartCheckIn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Start 15s Check-In"
        android:textAllCaps="false"
        android:backgroundTint="#00838f"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/btnViewHistory"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- View History Button -->
    <Button
        android:id="@+id/btnViewHistory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📅 View History"
        android:textAllCaps="false"
        android:backgroundTint="#333333"
        android:layout_marginBottom="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>